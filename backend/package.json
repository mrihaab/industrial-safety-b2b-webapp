{
  "name": "ghulam-safety-hub-backend",
  "version": "1.0.0",
  "description": "Backend REST API server for Ghulam Safety Hub B2B Portal",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/server.ts",
    "build": "npm install && tsc -p . && tsc-alias",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "db:init": "ts-node -r tsconfig-paths/register src/config/initDb.ts",
    "db:test": "ts-node -r tsconfig-paths/register src/config/testDb.ts",
    "db:seed": "ts-node -r tsconfig-paths/register src/config/seedDb.ts",
    "admin:create": "ts-node -r tsconfig-paths/register src/scripts/createAdmin.ts",
    "test:products": "ts-node -r tsconfig-paths/register src/config/testProductsApi.ts",
    "test:categories": "ts-node -r tsconfig-paths/register src/config/testCategoriesApi.ts",
    "test:rfq": "ts-node -r tsconfig-paths/register src/config/testRfqApi.ts",
    "test:mail": "ts-node -r tsconfig-paths/register src/config/testMailService.ts",
    "test:auth": "ts-node -r tsconfig-paths/register src/config/testAuthApi.ts",
    "test:admin-products": "ts-node -r tsconfig-paths/register src/config/testAdminProductCrud.ts"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.12",
    "@types/nodemailer": "^6.4.15",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "mysql2": "^3.9.7",
    "nodemailer": "^6.9.13",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "ts-node-dev": "^2.0.0"
  }
}
